{
  "name": "fileshed",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "src/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ALLOWED_HOSTS=* TRUSTED_ORIGINS=* TSC_WATCHFILE=DynamicPriorityPolling npm run dev -w @fileshed/client",
    "dev:server": "ALLOWED_HOSTS=* TRUSTED_ORIGINS=* node --env-file=.env --watch src/server/server.ts",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "lint:types": "npm run lint:types --workspaces --if-present",
    "test": "vitest run",
    "test:server": "vitest run --project server",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepare": "husky || true",
    "release": "scripts/release.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --max-warnings=0 --no-warn-ignored --fix"
  }
}
