{
  "name": "fileshed",
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "src/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ALLOWED_HOSTS=* TRUSTED_ORIGINS=* TSC_WATCHFILE=DynamicPriorityPolling npm run dev -w @fileshed/client",
    "dev:server": "ALLOWED_HOSTS=* TRUSTED_ORIGINS=* node --env-file=.env --watch src/server/server.ts",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "lint:types": "npm run lint:types --workspaces --if-present && npm run lint:types:tests",
    "test": "vitest run",
    "test:server": "vitest run --project server",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepare": "husky || true",
    "release": "scripts/release.sh",
    "lint:types:tests": "vue-tsc --noEmit -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/ui": "^4.12.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@hono/vite-dev-server": {
      "@hono/node-server": "^2.1.5"
    },
    "esbuild": "^0.28.2",
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --max-warnings=0 --no-warn-ignored --fix"
  }
}
