# FileShed development environment.
#
# The committed config/config.yaml is the configuration of record: every value there substitutes ${VAR:-fallback} against
# this environment, so these variables flow THROUGH the yaml file. This sample covers the ones a dev box usually
# sets; see config/config.yaml for the full set and docs/deployment.md for deployment guidance.

# Interface the server binds to (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Port the server listens on
PORT=3950

# Editor launched when opening files from the app
LAUNCH_EDITOR=webstorm

# Log verbosity: trace, debug, info, warn, error, fatal, silent (defaults to info)
#LOG_LEVEL=info

# Database backend: sqlite or postgres (defaults to sqlite)
DATABASE_KIND=sqlite

# SQLite database file path (sqlite backend only)
DATABASE_PATH=./data/fileshed.db

# Postgres connection string -- required when DATABASE_KIND=postgres
#DATABASE_URL=postgres://user:password@localhost:5432/fileshed

# The key that signs sessions and encrypts stored instance secrets -- min 32 characters. Unset, the server keeps
# one in ./data/auth-secret and generates it on first run. Set it to hold the key yourself (openssl rand -base64
# 32), or point AUTH_SECRET_FILE at a file holding it. See docs/secrets.md.
#AUTH_SECRET=
#AUTH_SECRET_FILE=/run/secrets/fileshed_auth_secret

# The key being replaced, for the one boot after a rotation: stored secrets move to the new key, then remove this.
#AUTH_SECRET_PREVIOUS=

# Public base URL the app is served from
BASE_URL=http://localhost:5173

# Root directory the filesystem blob store keeps content under (also seeds the default storage backend)
STORAGE_ROOT=./data/blobs

# Days a dereferenced blob lingers in the graveyard before GC hard-deletes it (0 = collect immediately)
GC_GRACE_DAYS=7

# Minutes between GC sweeps
GC_INTERVAL_MINUTES=60

# Maximum byte count for a single upload (defaults to 5 GiB)
UPLOAD_MAX_BYTES=5368709120

# Maximum byte count for a single avatar image (defaults to 2 MiB)
AVATAR_MAX_BYTES=2097152

# First-run setup is a web wizard: boot prints a one-time setup code to the console (a fresh one every boot until
# setup completes). For non-interactive provisioning, set your own token here and POST /api/setup with it instead.
#FILESHED_SETUP_TOKEN=choose-a-setup-token
